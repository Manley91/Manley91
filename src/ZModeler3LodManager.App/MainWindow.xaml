<Window x:Class="ZModeler3LodManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZModeler3 LOD Manager" Height="720" Width="900" MinHeight="500" MinWidth="700">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Help">
                <MenuItem Header="_About .z3d support..." Click="AboutZ3dMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <ToggleButton DockPanel.Dock="Top" x:Name="PinToggleButton" Content="📌 Keep window on top of ZModeler3"
                      HorizontalAlignment="Left" Margin="8,4" Padding="8,3"
                      Checked="PinToggle_Checked" Unchecked="PinToggle_Unchecked"/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Live.StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <DockPanel Margin="10">
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"
                       Text="Step 1: attach and inspect - this only reads the window, nothing is changed yet."/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Attach to ZModeler3" Command="{Binding Live.AttachCommand}" Padding="10,4" Margin="0,0,8,0"/>
                <Button Content="Inspect window" Command="{Binding Live.InspectCommand}" Padding="10,4" Margin="0,0,8,0"/>
                <Button Content="Probe: double-click first row" Command="{Binding Live.TryRenameProbeCommand}" Padding="10,4" Margin="0,0,8,0"
                        ToolTip="Diagnostic only - double-left-clicks the first Scene nodes browser row (ZModeler3's actual rename trigger) to see what appears. Doesn't type or commit anything."/>
                <Button Content="Clear" Command="{Binding Live.ClearCommand}" Padding="10,4"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Test rename value:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Live.TestRenameValue, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                <Button Content="Try full rename on first row" Command="{Binding Live.TryFullRenameCommand}" Padding="10,4" FontWeight="Bold"
                        ToolTip="Double-clicks the first row, selects all, types the test value above, and presses Enter - this actually renames it if everything works."/>
            </StackPanel>

            <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" BorderBrush="LightGray" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Organize Existing LODs - select the variants in ZModeler3 (top to bottom = highest to lowest detail), then click Rename."
                               FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LOD levels:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.LevelCount, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,16,0"/>

                        <TextBlock Text="Naming pattern:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.SuffixFormat, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,0"/>

                        <TextBlock Text="Base name (optional):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.BaseNameOverride, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,16,0"
                                 ToolTip="Leave blank to derive the base name from the first selected row's current name."/>

                        <Button Content="Rename Selected as LODs" Command="{Binding Live.RenameSelectedCommand}" Padding="10,4" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" BorderBrush="LightGray" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Auto rename sirens - select all the siren rows in order, then click Rename."
                               FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Base name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.SirenBaseName, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,0"/>

                        <TextBlock Text="Start number:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.SirenStartNumber, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,16,0"/>

                        <Button Content="Rename Selected as siren1-32" Command="{Binding Live.RenameSelectedAsSirensCommand}" Padding="10,4" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Live.StatusText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBox Text="{Binding Live.TreeDump, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      TextWrapping="NoWrap" AcceptsReturn="True"/>
        </DockPanel>
    </DockPanel>
</Window>
