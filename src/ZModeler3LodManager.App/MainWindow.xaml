<Window x:Class="ZModeler3LodManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZModeler3 LOD Manager" Height="720" Width="1100" MinHeight="500" MinWidth="800">
    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Model..." Command="{Binding File.OpenCommand}"/>
                <MenuItem Header="_Save As..." Command="{Binding File.SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About .z3d support..." Click="AboutZ3dMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <ToggleButton DockPanel.Dock="Top" x:Name="PinToggleButton" Content="📌 Keep window on top of ZModeler3"
                      HorizontalAlignment="Left" Margin="8,4" Padding="8,3"
                      Checked="PinToggle_Checked" Unchecked="PinToggle_Unchecked"/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding File.StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <TabItem Header="File (.obj / .json / .z3d)">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Mode:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                                <RadioButton GroupName="Mode" Content="Organize Existing LODs"
                                             IsChecked="{Binding File.IsOrganizeExistingMode}" Margin="0,0,16,0"
                                             ToolTip="For parts that already have LOD meshes with different polygon counts: identify and rename them."/>
                                <RadioButton GroupName="Mode" Content="Create LOD Copies"
                                             IsChecked="{Binding File.IsCreateCopiesMode}"
                                             ToolTip="For parts without LODs yet: duplicate each one into the configured number of LOD levels."/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LOD levels:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding File.LevelCount, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,16,0"/>

                                <TextBlock Text="Naming pattern:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding File.SuffixFormat, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,0"
                                         ToolTip="{}{n} is replaced by the level number, e.g. _L0, _L1, _L2."/>

                                <Button Content="Open Model..." Command="{Binding File.OpenCommand}" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="Generate Preview" Command="{Binding File.GeneratePreviewCommand}" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="Apply" Command="{Binding File.ApplyCommand}" Padding="10,4" Margin="0,0,8,0" FontWeight="Bold"/>
                                <Button Content="Save As..." Command="{Binding File.SaveAsCommand}" Padding="10,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="10">
                            <TextBlock DockPanel.Dock="Top" Text="Hierarchy (check one or more parts to process)"
                                       FontWeight="Bold" Margin="0,0,0,6"/>
                            <TreeView ItemsSource="{Binding File.Roots}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

                        <Grid Grid.Column="2" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="120"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Top" Text="Preview (nothing is changed until you click Apply)"
                                           FontWeight="Bold" Margin="0,0,0,6"/>
                                <DataGrid ItemsSource="{Binding File.PreviewOperations}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Change" Binding="{Binding Kind}" Width="80"/>
                                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                                        <DataGridTextColumn Header="Old Name" Binding="{Binding OldName}" Width="1*"/>
                                        <DataGridTextColumn Header="New Name" Binding="{Binding NewName}" Width="1*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Notes" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ListBox ItemsSource="{Binding File.Notes}"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Live (attach to ZModeler3)">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"
                               Text="Step 1: attach and inspect - this only reads the window, nothing is changed yet."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Attach to ZModeler3" Command="{Binding Live.AttachCommand}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Inspect window" Command="{Binding Live.InspectCommand}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Probe: Alt+click first row" Command="{Binding Live.TryRenameProbeCommand}" Padding="10,4" Margin="0,0,8,0"
                                ToolTip="Diagnostic only - Alt+left-clicks the first Scene nodes browser row (ZModeler3's own rename trigger) to see what appears. Doesn't type or commit anything."/>
                        <Button Content="Clear" Command="{Binding Live.ClearCommand}" Padding="10,4"
                                ToolTip="Clears the log below, so you can do something in ZModeler3 and then Inspect again without the old output in the way."/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding Live.StatusText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBox Text="{Binding Live.TreeDump, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              TextWrapping="NoWrap" AcceptsReturn="True"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
