<Window x:Class="ZModeler3LodManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZModeler3 LOD Manager" Height="720" Width="1100" MinHeight="500" MinWidth="800">
    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Model..." Command="{Binding OpenCommand}"/>
                <MenuItem Header="_Save As..." Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About .z3d support..." Click="AboutZ3dMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" Padding="10" BorderBrush="LightGray" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Mode:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <RadioButton GroupName="Mode" Content="Organize Existing LODs"
                                 IsChecked="{Binding IsOrganizeExistingMode}" Margin="0,0,16,0"
                                 ToolTip="For parts that already have LOD meshes with different polygon counts: identify and rename them."/>
                    <RadioButton GroupName="Mode" Content="Create LOD Copies"
                                 IsChecked="{Binding IsCreateCopiesMode}"
                                 ToolTip="For parts without LODs yet: duplicate each one into the configured number of LOD levels."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LOD levels:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding LevelCount, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,16,0"/>

                    <TextBlock Text="Naming pattern:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding SuffixFormat, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,0"
                             ToolTip="{}{n} is replaced by the level number, e.g. _L0, _L1, _L2."/>

                    <Button Content="Open Model..." Command="{Binding OpenCommand}" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="Generate Preview" Command="{Binding GeneratePreviewCommand}" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="10,4" Margin="0,0,8,0" FontWeight="Bold"/>
                    <Button Content="Save As..." Command="{Binding SaveAsCommand}" Padding="10,4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="Hierarchy (check one or more parts to process)"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <TreeView ItemsSource="{Binding Roots}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="Preview (nothing is changed until you click Apply)"
                               FontWeight="Bold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding PreviewOperations}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding Kind}" Width="80"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTextColumn Header="Old Name" Binding="{Binding OldName}" Width="1*"/>
                            <DataGridTextColumn Header="New Name" Binding="{Binding NewName}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Notes" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Notes}"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
