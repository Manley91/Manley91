<Window x:Class="ZModeler3LodManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HNKM Easy Dev Tool" Height="720" Width="900" MinHeight="500" MinWidth="700"
        Background="#1E1E1E">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
        <SolidColorBrush x:Key="ControlBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="Accent" Color="#3DA5F4"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1E4E7A"/>
        <SolidColorBrush x:Key="TextColor" Color="#E6E6E6"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Help">
                <MenuItem Header="_About .z3d support..." Click="AboutZ3dMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#14202E" BorderThickness="0,0,0,2" BorderBrush="{StaticResource Accent}" Padding="12,10" CornerRadius="0">
            <TextBlock Text="HNKM Easy Dev Tool" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
        </Border>

        <ToggleButton DockPanel.Dock="Top" x:Name="PinToggleButton" Content="📌 Keep window on top of ZModeler3"
                      HorizontalAlignment="Left" Margin="8,4" Padding="8,3"
                      Checked="PinToggle_Checked" Unchecked="PinToggle_Unchecked"/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Live.StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <DockPanel Margin="10">
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"
                       Text="Step 1: attach and inspect - this only reads the window, nothing is changed yet."/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Attach to ZModeler3" Command="{Binding Live.AttachCommand}" Padding="10,4" Margin="0,0,8,0"/>
                <Button Content="Inspect window" Command="{Binding Live.InspectCommand}" Padding="10,4" Margin="0,0,8,0"/>
                <Button Content="Probe: double-click first row" Command="{Binding Live.TryRenameProbeCommand}" Padding="10,4" Margin="0,0,8,0"
                        ToolTip="Diagnostic only - double-left-clicks the first Scene nodes browser row (ZModeler3's actual rename trigger) to see what appears. Doesn't type or commit anything."/>
                <Button Content="Clear" Command="{Binding Live.ClearCommand}" Padding="10,4"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Test rename value:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Live.TestRenameValue, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                <Button Content="Try full rename on first row" Command="{Binding Live.TryFullRenameCommand}" Padding="10,4" FontWeight="Bold"
                        ToolTip="Double-clicks the first row, selects all, types the test value above, and presses Enter - this actually renames it if everything works."/>
            </StackPanel>

            <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Organize Existing LODs - select the variants in ZModeler3 (top to bottom = highest to lowest detail), then click Rename."
                               FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LOD levels:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.LevelCount, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,16,0"/>

                        <TextBlock Text="Naming pattern:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.SuffixFormat, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,0"/>

                        <TextBlock Text="Base name (optional):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.BaseNameOverride, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,16,0"
                                 ToolTip="Leave blank to derive the base name from the first selected row's current name."/>

                        <Button Content="Rename Selected as LODs" Command="{Binding Live.RenameSelectedCommand}" Padding="10,4" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Auto rename sirens - select all the siren rows in order, then click Rename."
                               FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Base name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.SirenBaseName, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,0"/>

                        <TextBlock Text="Start number:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.SirenStartNumber, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,16,0"/>

                        <Button Content="Rename Selected as siren1-32" Command="{Binding Live.RenameSelectedAsSirensCommand}" Padding="10,4" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Scale Selected - select node(s) in the Scene nodes browser, then click Scale. Writes the value into Properties &gt; Transformation &gt; Scale &gt; X/Y/Z, one node at a time."
                               FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="First time using this on a scene: try it on one node first and keep Ctrl+Z (Undo) ready, in case a value doesn't take cleanly."
                               Margin="0,0,0,8" TextWrapping="Wrap" FontStyle="Italic"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Scale to:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Live.ScaleValue, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,16,0"/>

                        <Button Content="Scale Selected (X/Y/Z)" Command="{Binding Live.ScaleSelectedCommand}" Padding="10,4" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Live.StatusText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBox Text="{Binding Live.TreeDump, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      TextWrapping="NoWrap" AcceptsReturn="True"/>
        </DockPanel>
    </DockPanel>
</Window>
