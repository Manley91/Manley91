<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZModeler3LodManager</RootNamespace>
    <AssemblyName>ZModeler3LodManager</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZModeler3LodManager.Core\ZModeler3LodManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Automation, used to attach to and inspect the running ZModeler3 window (Live tab). -->
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

</Project>
